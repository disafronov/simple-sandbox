#!/bin/bash
# Fixed interpreter path: bash itself is part of the pre-sandbox trust chain,
# and `#!/usr/bin/env bash` would resolve it through an untrusted PATH.

set -euo pipefail
umask 077

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

(($# > 0)) ||
    die "no command specified"

[[ -n "${HOME:-}" ]] ||
    die "HOME is not set"

# The writable working directory must be known before tools can be resolved:
# a tool located inside it would be attacker-visible before the sandbox
# starts. Resolve the toolchain immediately, before any XDG_RUNTIME_DIR
# handling or state-path computation.
workdir="$(pwd -P)"

# Make ${PWD} in path policies refer to the physical invocation directory.
export PWD="$workdir"

# Resolve every tool the wrapper runs before exec'ing bwrap to a canonical
# absolute path and refuse tools located inside the writable working
# directory. All later invocations use the resolved paths, never the PATH.
declare -A tools

resolve_tool() {
    local tool="$1"
    local path

    path="$(command -v "$tool")" ||
        die "$tool is not installed"

    # realpath is resolved by this very loop; use the plain command here.
    path="$(realpath "$path")" ||
        die "cannot resolve $tool: $path"

    case "$path" in
        "$workdir"|"$workdir"/*)
            die "refusing to use $tool from the working directory: $path"
            ;;
    esac

    tools["$tool"]="$path"
}

# bash is part of the pre-sandbox trust chain: the fixed #!/bin/bash shebang
# covers the normal launch path, but if the script is ever invoked via
# `bash ./simple-sandbox`, a workdir-resident bash must be refused too.
for tool in \
    bash \
    bwrap \
    envsubst \
    flock \
    jq \
    realpath \
    sha256sum \
    grep \
    cut \
    sort \
    mkdir \
    chmod
do
    resolve_tool "$tool"
done

# A setuid bwrap would escalate privileges outside the sandbox contract;
# the resolver must have refused a workdir-resident binary already, and an
# installed setuid binary is refused here.
[[ ! -u "${tools[bwrap]}" ]] ||
    die "refusing setuid bubblewrap: ${tools[bwrap]}"

# XDG_RUNTIME_DIR must be set to an existing, writable directory. These
# checks use only bash builtins, so they can run before any resolved tool.
[[ -n "${XDG_RUNTIME_DIR:-}" ]] ||
    die "XDG_RUNTIME_DIR is not set"

[[ -d "$XDG_RUNTIME_DIR" ]] ||
    die "XDG_RUNTIME_DIR does not exist: $XDG_RUNTIME_DIR"

[[ -w "$XDG_RUNTIME_DIR" ]] ||
    die "XDG_RUNTIME_DIR is not writable: $XDG_RUNTIME_DIR"

home_root="$("${tools[realpath]}" "$HOME")"
runtime_root="$("${tools[realpath]}" "$XDG_RUNTIME_DIR")"

"${tools[bwrap]}" --help 2>&1 | "${tools[grep]}" -q -- '--overlay-src' ||
    die "installed bubblewrap does not support persistent overlays"

sandbox_id="$(
    printf '%s' "$workdir" |
        "${tools[sha256sum]}" |
        "${tools[cut]}" -d' ' -f1
)"

sandbox_root="$runtime_root/simple-sandbox/$sandbox_id"
home_upper="$sandbox_root/home-upper"
home_work="$sandbox_root/home-work"
sandbox_runtime="$sandbox_root/runtime"
overlays_root="$sandbox_root/overlays"
lock_file="$sandbox_root/lock"

"${tools[mkdir]}" -p \
    "$home_upper" \
    "$home_work" \
    "$sandbox_runtime" \
    "$overlays_root"

"${tools[chmod]}" 700 \
    "$sandbox_root" \
    "$home_upper" \
    "$home_work" \
    "$sandbox_runtime" \
    "$overlays_root"

if [[ -n "${SIMPLE_SANDBOX_CONFIG:-}" ]]; then
    config_file="$("${tools[realpath]}" -m -- "$SIMPLE_SANDBOX_CONFIG")"

    [[ -f "$config_file" ]] ||
        die "configuration file does not exist: $config_file"
else
    config_file="${XDG_CONFIG_HOME:-$HOME/.config}/simple-sandbox.json"

    [[ -f "$config_file" ]] ||
        config_file=""
fi

policy_paths=()
policy_actions=()
unset_vars=()

if [[ -n "$config_file" ]]; then
    "${tools[jq]}" -e '
        type == "object"
        and ((keys - ["paths", "unset"]) | length == 0)

        and ((.paths // {}) | type == "object")
        and all(
            ((.paths // {}) | keys[]);
            length > 0
            and (contains("\n") | not)
            and (contains("\u0000") | not)
        )
        and all(
            (.paths // {})[];
            IN("hide", "readonly", "expose", "overlay")
        )

        and ((.unset // []) | type == "array")
        and all(
            (.unset // [])[];
            type == "string"
            and test("^[A-Za-z_][A-Za-z0-9_]*$")
        )
    ' "$config_file" >/dev/null ||
        die "invalid configuration: $config_file"

    # Extract (path, action) pairs while preserving JSON object order.
    # NUL delimiters preserve spaces and tabs in paths.
    while IFS= read -r -d '' path && IFS= read -r -d '' action; do
        policy_paths+=("$path")
        policy_actions+=("$action")
    done < <(
        "${tools[jq]}" -j '
            (.paths // {})
            | to_entries[]
            | (.key + "\u0000" + .value + "\u0000")
        ' "$config_file"
    )

    mapfile -t unset_vars < <(
        "${tools[jq]}" -r '.unset // [] | .[]' "$config_file"
    )
fi

resolve_policy_path() {
    local path="$1"
    local variable
    local parent
    local name

    while IFS= read -r variable; do
        [[ -v "$variable" ]] ||
            die "unknown variable in path: $variable"
    done < <("${tools[envsubst]}" --variables "$path")

    path="$(printf '%s\n' "$path" | "${tools[envsubst]}")"

    case "$path" in
        "~")
            path="$HOME"
            ;;
        "~/"*)
            path="$HOME/${path:2}"
            ;;
    esac

    if [[ "$path" != /* ]]; then
        path="$workdir/$path"
    fi

    # First normalize lexical components without following symlinks.
    path="$("${tools[realpath]}" -m -s -- "$path")"

    [[ "$path" != "/" ]] ||
        die "refusing to apply a path policy to the filesystem root"

    # Resolve symlinks in parent components, but preserve the final component
    # as the mount destination. Thus /var/run/socket becomes /run/socket,
    # while a final-component symlink remains the named policy target.
    parent="${path%/*}"
    name="${path##*/}"

    [[ -n "$parent" ]] ||
        parent="/"

    parent="$("${tools[realpath]}" -m -- "$parent")"
    path="${parent%/}/$name"

    printf '%s\n' "$path"
}

bwrap_args=(
    --die-with-parent
    --unshare-all
    --share-net
    --ro-bind / /
    --proc /proc
    --dev /dev
)

if [[ "$workdir" == "$home_root" ]]; then
    bwrap_args+=(
        --overlay-src "$home_root"
        --overlay "$home_upper" "$home_work" "$home_root"
    )
elif [[ "$workdir" == "/" || "$home_root" == "$workdir/"* ]]; then
    bwrap_args+=(
        --bind "$workdir" "$workdir"
        --overlay-src "$home_root"
        --overlay "$home_upper" "$home_work" "$home_root"
    )
else
    bwrap_args+=(
        --overlay-src "$home_root"
        --overlay "$home_upper" "$home_work" "$home_root"
        --bind "$workdir" "$workdir"
    )
fi

bwrap_args+=(
    --tmpfs /tmp
    --bind "$sandbox_runtime" "$runtime_root"
)

apply_path_policies() {
    local -a resolved_paths=()
    local -a resolved_actions=()
    local -A seen_actions=()
    local -a sorted_indices=()
    local -i i
    local idx
    local path
    local action
    local overlay_id
    local overlay_root
    local overlay_upper
    local overlay_work

    for ((i = 0; i < ${#policy_paths[@]}; i++)); do
        path="$(resolve_policy_path "${policy_paths[i]}")"
        action="${policy_actions[i]}"

        if [[ -v "seen_actions[$path]" ]]; then
            [[ "${seen_actions[$path]}" == "$action" ]] ||
                die "conflicting path policies for $path: ${seen_actions[$path]} vs $action"
            continue
        fi

        seen_actions["$path"]="$action"
        resolved_paths+=("$path")
        resolved_actions+=("$action")
    done

    # Parent destinations are mounted before children. Ties preserve config
    # order, while deeper destinations naturally override parent mounts.
    while IFS=$'\t' read -r _ idx; do
        sorted_indices+=("$idx")
    done < <(
        for ((i = 0; i < ${#resolved_paths[@]}; i++)); do
            printf '%d\t%d\n' "${#resolved_paths[i]}" "$i"
        done |
            "${tools[sort]}" -n -k1,1 -k2,2
    )

    for idx in "${sorted_indices[@]}"; do
        path="${resolved_paths[idx]}"
        action="${resolved_actions[idx]}"

        [[ -e "$path" || -L "$path" ]] ||
            continue

        case "$action" in
            hide)
                if [[ -d "$path" ]]; then
                    bwrap_args+=(--tmpfs "$path")
                else
                    bwrap_args+=(--ro-bind /dev/null "$path")
                fi
                ;;
            readonly)
                bwrap_args+=(--ro-bind "$path" "$path")
                ;;
            expose)
                bwrap_args+=(--bind "$path" "$path")
                ;;
            overlay)
                [[ -d "$path" ]] ||
                    die "overlay path is not a directory: $path"

                overlay_id="$(
                    printf '%s' "$path" |
                        "${tools[sha256sum]}" |
                        "${tools[cut]}" -d' ' -f1
                )"

                overlay_root="$overlays_root/$overlay_id"
                overlay_upper="$overlay_root/upper"
                overlay_work="$overlay_root/work"

                "${tools[mkdir]}" -p \
                    "$overlay_upper" \
                    "$overlay_work"

                "${tools[chmod]}" 700 \
                    "$overlay_root" \
                    "$overlay_upper" \
                    "$overlay_work"

                bwrap_args+=(
                    --overlay-src "$path"
                    --overlay "$overlay_upper" "$overlay_work" "$path"
                )
                ;;
            *)
                die "unknown path policy: $action"
                ;;
        esac
    done
}

apply_path_policies

for name in "${unset_vars[@]}"; do
    bwrap_args+=(--unsetenv "$name")
done

bwrap_args+=(
    --setenv TMPDIR /tmp
    --setenv XDG_RUNTIME_DIR "$runtime_root"
    --chdir "$workdir"
    --
    "$@"
)

# One upper/work pair cannot safely back concurrent overlay mounts.
exec 9>"$lock_file"
"${tools[flock]}" -x 9

exec "${tools[bwrap]}" "${bwrap_args[@]}"
